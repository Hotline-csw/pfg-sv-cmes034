<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Resources = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Themes.Resources"
                    xmlns:hgc = "http://schemas.homag-group.com/ControlLibrary/1.0/xaml"
                    xmlns:telerik = "http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:trans = "clr-namespace:HomagGroup.FLS.Domain.Data.Properties;assembly=HomagGroup.FLS.Domain.Data"
                    xmlns:Commands = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Commands;assembly=HomagGroup.FLS.Infrastructure.Framework"
                    xmlns:Controls = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Controls;assembly=HomagGroup.FLS.Infrastructure.Framework"
  					xmlns:Converter = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Converter;assembly=HomagGroup.FLS.Infrastructure.Framework">
	
	<Converter:ValueToImageConverter x:Key="IntToImg">
        <Converter:ValueToImage Value="0" ImageKey="false"/> 
        <Converter:ValueToImage Value="1" ImageKey="true"/>
    </Converter:ValueToImageConverter>
	
	<!-- Change 1: Style name = WorkCenter name -->
    <Style x:Key="CompletedOrAllowed" TargetType="telerik:GridViewCell"> 
        <Style.Setters>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
						<StackPanel Orientation="Horizontal">
							
							<!-- Change 2: Set name icon, add fields from the view -->
							<StackPanel.Resources>
								<PropertyPath x:Key="completedorallowed">DataContext.CompletedOrAllowed</PropertyPath> <!-- Field with percentage info-->
							</StackPanel.Resources>
							<!-- No more changes required -->
						
                            <Rectangle x:Name="imgCompleted" Width="35" Height="35" Margin="5" Fill="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource completedorallowed}, Converter={StaticResource IntToImg}}"/>                    							

						</StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
    </Style>
	
	
</ResourceDictionary>