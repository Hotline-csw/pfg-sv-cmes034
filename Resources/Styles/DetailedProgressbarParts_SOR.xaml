<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Resources = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Themes.Resources"
                    xmlns:hgc = "http://schemas.homag-group.com/ControlLibrary/1.0/xaml"
                    xmlns:telerik = "http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:trans = "clr-namespace:HomagGroup.FLS.Domain.Data.Properties;assembly=HomagGroup.FLS.Domain.Data"
                    xmlns:Commands = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Commands;assembly=HomagGroup.FLS.Infrastructure.Framework"
                    xmlns:Controls = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Controls;assembly=HomagGroup.FLS.Infrastructure.Framework"
  					xmlns:Converter = "clr-namespace:HomagGroup.FLS.Infrastructure.Framework.Converter;assembly=HomagGroup.FLS.Infrastructure.Framework">
	
    <Converter:ValueToImageConverter x:Key="ValueToIcon">
    </Converter:ValueToImageConverter>
	
	<!-- Change 1: Style name = WorkCenter name -->
    <Style x:Key="DetailedProgressbarParts_SOR" TargetType="telerik:GridViewCell"> 
        <Style.Setters>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>

						<StackPanel Orientation="Horizontal">
							
							<!-- Change 2: Set name icon, add fields from the view -->
							<StackPanel.Resources>
								<system:String x:Key="imagekey">sort</system:String>
								<PropertyPath x:Key="percentage">DataContext.SORPercentage</PropertyPath> <!-- Field with percentage info-->
								<PropertyPath x:Key="qty">DataContext.SORQty</PropertyPath> <!-- Field with current and desired quantity info-->
							</StackPanel.Resources>
							<!-- No more changes required -->
						
							<Rectangle x:Name="icon" Width="45" Height="45" Margin="5" Fill="{Binding Source={StaticResource imagekey}, Converter={StaticResource ValueToIcon}}">
								<Rectangle.Style>
									<Style TargetType="Rectangle">
										<Style.Triggers>
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="x">
												<Setter Property="Visibility" Value="Hidden" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Rectangle.Style>
							</Rectangle>
							

						<StackPanel>
							<Border Name="progBorder"
								Margin="3,5,3,5" Width="110" Height="25"
								BorderBrush="Black" BorderThickness="2" HorizontalAlignment="Left">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="x">
												<Setter Property="Visibility" Value="Hidden" />
										</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>

							<Grid>
							<ProgressBar x:Name="progressBar1"
								Margin="0"
								Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}}" 
								Minimum="0"
								Maximum="100"
							>
							
							<ProgressBar.Style>
								<Style TargetType="{x:Type ProgressBar}">
									<Setter Property="Foreground" Value="Yellow" />
									<Setter Property="Background" Value="Gray" />
								   
									<Style.Triggers>
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="x">
												<Setter Property="Visibility" Value="Hidden" />
										</DataTrigger>
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="0">
													<Setter Property="Foreground" Value="Red" />
													<Setter Property="Background" Value="LightCoral" />   
										</DataTrigger>
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="100">
													<Setter Property="Foreground" Value="LawnGreen" />
													<Setter Property="Background" Value="Gray" /> 
										</DataTrigger>									
									</Style.Triggers>
								</Style>
							</ProgressBar.Style>
							
							</ProgressBar>
							
							<TextBlock Text="{Binding ElementName=progressBar1, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="Black" >
								<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="x">
											<Setter Property="Visibility" Value="Hidden" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
								</TextBlock.Style>
							</TextBlock>
							
							</Grid>
							</Border>
							<StackPanel Orientation="Horizontal">
								<TextBlock Margin="3,0,3,5" VerticalAlignment="Center" FontFamily="{DynamicResource {x:Static hgc:Keys.StandardFontFamily}}" FontSize="12" FontWeight="Bold"  Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource qty}, StringFormat={}Parts: {0:0}}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type telerik:GridViewCell}}, Path={StaticResource percentage}, TargetNullValue=x}" Value="x">
													<Setter Property="Visibility" Value="Hidden" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>								
							</StackPanel>	
						</StackPanel>
						</StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style.Setters>
        <Style.Triggers>	
        </Style.Triggers>
    </Style>
	
	
</ResourceDictionary>