{
	"label": "CustomerOrder bulk planning",
	"entityType": "CustViewBulkPlanning",
	"valueField": "",
	"returnDetailSequence": true,
	"select": [
		{
			"name": "OrderNumber",
			"label": "Order number",
			"field": "Min(Key.OrderNumber)",
			"keyFigure": {
				"label": "Qty customer orders",
				"max": "5",
				"aggregate": "distinct",
				"fieldType": "number"
			}
		},
		{
			"name": "OrderDate",
			"label": "Order date",
			"filter": true,
			"field": "Min(OrderDate) as OrderDate"
		},
		{
			"name": "NarrowParts",
			"label": "Narrow parts",
			"filter": true,
			"field": "Sum(if(NarrowPart > 1, 1, 0)) AS NarrowParts",
			"keyFigure": {
				"label": "Qty narrow parts",
				"min": "20",
				"max": "60",
				"aggregate": "sum",
				"fieldType": "number"
			}
		},
		{
			"name": "Volume",
			"label": "Volume",
			"field": "Sum(Volume)",
			"keyFigure": {
				"label": "Volume",
				"min": "4",
				"max": "10",
				"aggregate": "sum",
				"fieldType": "number"
			}
		},
		{
			"name": "Materials",
			"label": "Materials",
			"filter": true,
			"field": "g.Select(x => x.Material).Distinct() as Materials",
			"keyFigure": {
				"label": "Materials",
				"aggregate": "merge",
				"fieldType": "text"
			}
		}
	],
	"where": [
		"(ProductionState == 0)",
		"(PlanningSequence == null)",
		"(OrderType == 3)"
	],
	"groupBy": [
		"Key.OrderNumber"
	],
	"orderBy": [
		"Key.OrderNumber"
	],
	"functionBlock": {
		"label": "Add to bulk",
		"initialize": "BulkPlanningSet",
		"execute": "BulkPlanning",
		"fields": [
			{
				"name": "name",
				"label": "Bulk name",
				"fieldType": "text",
				"value": ""
			},
			{
				"name": "date",
				"label": "Plan date",
				"fieldType": "date",
				"value": ""
			},
			{
				"name": "color",
				"label": "color",
				"fieldType": "color",
				"value": ""
			}
		]
	},
	"infoArea": [
		{
			"component": "cmes-simulate-capacity",
			"calculate": "BulkPlanningProgress",
			"parameter": [
				"3010",
				"6010"
			]
		},
		{
			"component": "cmes-key-figures"
		}
	]
}