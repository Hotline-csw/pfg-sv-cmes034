{
  "label": "Kundenauftragsverplanung",
  "entityType": "ProductionOrder",
  "valueField": "Quantity",
  "returnDetailSequence": true,
  "select": [
    {
      "name": "Kunde",
      "label": "Kunde",
      "field": "Key.CustomerOrder as Kunde",
      "keyFigure": {
        "label": "Anzahl Kundenaufträge",
        "max": "2",
        "aggregate": "distinct"
      }
    },
    {
      "name": "Auftragsnummer",
      "label": "Auftragsnummer",
      "field": "Min(CustomerOrder.Code) as Auftragsnummer"
    },
    {
      "name": "OrderCount",
      "label": "Anzahl FAs",
      "field": "Count() AS OrderCount",
      "keyFigure": {
        "label": "Anzahl Fertigungsaufträge",
        "max": "500",
        "aggregate": "sum"
      }
    },
    {
      "name": "Schmalteile",
      "label": "Anz. Schmalteile",
      "field": "Sum(iif(Width <= 130 && Width > 0, 1, 0)) AS Schmalteile",
      "keyFigure": {
        "label": "Anzahl Schmalteile",
        "max": "60",
        "aggregate": "sum"
      }
    },
    {
      "name": "PartArea",
      "label": "Ø Teilefläche (m²)",
      "field": "Average(Width*Length/1000000) AS PartArea"
    },
    {
      "name": "Materials",
      "label": "Materialien",
      "field": "g.Select(x => x.Material).Distinct() as Materials"
    }
  ],
  "where": [
    "(ProductionState == \"New\")",
    "(PlanningSequence == null)"
  ],
  "groupBy": [
    "SqlFunctions.DatePart(\"wk\", DesiredEndDate.Value) as Date",
    "CustomerOrder.Reference AS CustomerOrder"
  ],
  "orderBy": [
    "Key.Date",
    "Key.CustomerOrder"
  ],
  "functionBlock": {
    "label": "Verplanen",
    "initialize": "CustomBulkPlanningSetCust",
    "execute": "CustomBulkPlanningExecuteCust",
    "progress": "CustomBulkPlanningProgressChart",
    "fields": [
      {
        "name": "name",
        "label": "Pulkname",
        "fieldType": "text",
        "value": ""
      },
      {
        "name": "date",
        "label": "Plandatum",
        "fieldType": "date",
        "value": ""
      },
      {
        "name": "color",
        "label": "Farbe",
        "fieldType": "color",
        "value": ""
      }
    ]
  },
  "infoArea": [
    {
      "component": "cmes-simulate-capacity",
      "parameter": "6010"
    },
    {
      "component": "cmes-key-figures"
    }
  ]
}