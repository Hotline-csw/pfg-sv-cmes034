{
  "label": "CustomerOrder bulk planning",
  "entityType": "CustViewBulkPlanning",
  "valueField": "",
  "returnDetailSequence": true,
  "select": [
    {
      "name": "Materials",
      "label": "Materials",
      "filter": true,
      "field": "g.Select(x => x.Material).Distinct() as Materials",
      "keyFigure": {
        "label": "Materials",
        "aggregate": "merge",
        "fieldType": "text"
      }
    }
  ],
  "where": [
    "(ProductionState == 0)",
    "(PlanningSequence == null)",
    "(OrderType == 3)"
  ],
  "groupBy": [
    "Key.OrderNumber"
  ],
  "orderBy": [
    "Key.OrderNumber"
  ],
  "functionBlock": {
    "label": "Add to bulk",
    "initialize": "BulkPlanningSet",
    "execute": "BulkPlanning",
    "fields": [
      {
        "name": "name",
        "label": "Bulk name",
        "fieldType": "text",
        "value": ""
      },
      {
        "name": "date",
        "label": "Plan date",
        "fieldType": "date",
        "value": ""
      },
      {
        "name": "color",
        "label": "color",
        "fieldType": "color",
        "value": ""
      }
    ]
  },
  "infoArea": [
    {
      "component": "cmes-simulate-capacity",
      "calculate": "BulkPlanningProgress",
      "parameter": [
        "3010",
        "6010"
      ]
    },
    {
      "component": "cmes-key-figures"
    }
  ]
}