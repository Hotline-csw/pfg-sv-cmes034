{
  "label": "Kundenauftragsverplanung",
  "entityType": "ProductionOrder",
  "valueField": "Volumen",
  "returnDetailSequence": true,
  "select": [
    {
      "name": "Kunde",
      "label": "Kunde",
      "field": "Key.CustomerOrder as Kunde",
      "keyFigure": {
        "label": "Anzahl Kundenaufträge",
        "max": "5",
        "aggregate": "distinct"
      }
    },
    {
      "name": "Auftragsnummer",
      "label": "Auftragsnummer",
      "field": "Min(CustomerOrder.Code) as Auftragsnummer"
    },
    {
      "name": "Auftragsdatum",
      "label": "Auftragsdatum",
      "field": "Min(CustomerOrder.ShippingDate) as Auftragsdatum"
    },
    {
      "name": "Schmalteile",
      "label": "Anz. Schmalteile",
      "field": "Sum(iif(Width <= 130 && Width > 0, 1, 0)) AS Schmalteile",
      "keyFigure": {
        "label": "Anzahl Schmalteile",
        "max": "60",
        "aggregate": "sum"
      }
    },
    {
      "name": "Volumen",
      "label": "Volumen",
      "field": "Sum(CustomVolume) as Volumen",
      "keyFigure": {
        "label": "Volumen",
        "max": "1000",
        "aggregate": "sum",
        "min": "100"
      }
    },
    {
      "name": "Materials",
      "label": "Materialien",
      "field": "g.Select(x => x.Material).Distinct() as Materials"
    }
  ],
  "where": [
    "(ProductionState == \"New\")",
    "(PlanningSequence == null)"
  ],
  "groupBy": [
    "CustomerOrder.Reference AS CustomerOrder"
  ],
  "orderBy": [
    "Key.CustomerOrder"
  ],
  "functionBlock": {
    "label": "Verplanen",
    "initialize": "PulkPlanningSet",
    "execute": "PulkPlanning",
    "progress": "PulkPlanningProgress",
    "fields": [
      {
        "name": "name",
        "label": "Pulkname",
        "fieldType": "text",
        "value": ""
      },
      {
        "name": "date",
        "label": "Plandatum",
        "fieldType": "date",
        "value": ""
      },
      {
        "name": "color",
        "label": "Farbe",
        "fieldType": "color",
        "value": ""
      }
    ]
  },
  "infoArea": [
    {
      "component": "cmes-simulate-capacity",
      "parameter": [
        "6010"
      ]
    },
    {
      "component": "cmes-key-figures"
    }
  ]
}