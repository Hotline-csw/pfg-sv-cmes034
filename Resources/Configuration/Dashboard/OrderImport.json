[
  {
    "label": "Importierte Aufträge",
    "cols": 4,
    "rows": 2,
    "background": "#D2691E",
    "foreground": "#fff",
    "component": "cmes-dashboard-table-chart",
    "link": "cmes-custom-page/AlpnachImport",
   "input": {
      "names": ["CustomerOrder"],
      "colors": ["#ff0000"],
      "refresh": 5,	  
      "inputOData":
	  {
		"dataSource": "CustomerOrders",
		"select": "Code, CreationDate, Customer",
		"orderBy": "CreationDate desc",
		"top": 10
	  }
    }
  },
  {
    "label": "WCC - Aktueller Auftragsimport - Staging",
    "cols": 4,
    "rows": 2,
    "background": "#D2691E",
    "foreground": "#fff",
    "component": "cmes-dashboard-table-chart",
    "link": "cmes-custom-page/AlpnachImport",
   "input": {
      "names": ["Staging"],
      "colors": ["#ff0000"],
      "refresh": 5,	  
      "inputOData":
	  {
		"dataSource": "WccStagingRecords",
		"select": "OrderId",
		"filter": "TransferState eq 'TransferFromStagingToProductionInProcess'"	
	
	  }
    }
  }  
]
