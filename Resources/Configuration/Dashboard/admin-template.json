    "component": "cmes-dashboard-cmes-perf-chart",
    "link": "cmes-health",
	"input": {
		"chartName":"CMes Server 1",
		"refresh": 2,
		"inputMongo":
		{
			"dataSource": "PerfmonOneSecond",
			"instance": "CMES-DEV"
		}
	}
 },
{
    "label": "Sql Server 1",
    "cols": 6,
    "rows": 3,
    "background": "#ffffff",
    "foreground": "#000000",
    "component": "cmes-dashboard-sql-server-perf-chart",
    "link": "sql-server-health",
	"input": {
		"chartName":"SqlServer Server 1",
		"refresh": 2,
		"inputMongo":
		{
			"dataSource": "DatabasePerformance",
			"instance": "CMES-DEV"
		}
	}
 },

  
 {
    "label": "Benutzer",
    "cols": 2,
    "rows": 1,
    "background": "#FAF0E6",
    "component": "cmes-dashboard-user",
    "link": "cmes-custom-page/CmesHealthW3wp"
  },
 
 {
    "label": "SAWTEQ B300",
    "cols": 2,
    "rows": 2,
    "background": "#FFFFFF",
    "component": "cmes-dashboard-gauge-chart",
    "link": "cmes-custom-page/W2Demo",	
    "input": {
		"refresh": 10,	
		"colors": ["#777777"],
		"inputOData":
		{
			"dataSource": "ProductionItemsHistory",
			"filter": "WorkCenterCode eq '30010 Saw' and date(Timestamp) gt {now()-minutes(1)}",
			"count": true
		}
    }
  },
  {
    "label": "SAWTEQ B400",
    "cols": 2,
    "rows": 2,
    "background": "#FFFFFF",
    "component": "cmes-dashboard-gauge-chart",
    "link": "cmes-custom-page/W2Demo",	
    "input": {
		"refresh": 12,      
		"colors": ["#777777"],
		"inputOData":
		{
			"dataSource": "ProductionItemsHistory",
			"filter": "WorkCenterCode eq '30015 Saw' and date(Timestamp) gt {now()-minutes(1)}",
			"count": true
	  }
    }
  },
  {
    "label": "EDGETEC S-310",
    "cols": 2,
    "rows": 2,
    "background": "#FFFFFF",
    "component": "cmes-dashboard-gauge-chart",
    "link": "cmes-custom-page/W2Demo",	
    "input": {
		"refresh": 12,      
		"colors": ["#777777"],
		"inputOData":
		{
			"dataSource": "ProductionItemsHistory",
			"filter": "WorkCenterCode eq '30030 Edge' and date(Timestamp) gt {now()-minutes(1)}",
			"count": true
		}
    }
  },
  {
    "label": "Aufträge für heute",
    "cols": 2,
    "rows": 1,
    "background": "#FFFFFF",
    "component": "cmes-dashboard-count-chart",
    "link": "cmes-custom-page/W2Demo",	
    "input": {
		"refresh": 60,      
		"colors": ["#777777"],
		"inputOData":
		{
			"dataSource": "ProductionOrders",
			"filter": "date(DesiredEndDate) eq {Today}",
			"count": true
		}
    }
  },
  
  {
    "label": "Stapel",
    "cols": 2,
    "rows": 2,
    "background": "#D2691E",
    "foreground": "#ffffff",
    "component": "cmes-dashboard-count-chart",
    "link": "cmes-stack",
	"input": {
		"refresh": 60,
		"colors": ["#FFFFFF"],		
		"inputOData":
		{
			"dataSource": "IntelliStacks",
			"filter": "date(CreationDate) eq {Today}",
			"count": true
		}
    }
  },
  {
    "label": "Nachfertigungen",
    "cols": 2,
    "rows": 1,
    "background": "#ff8000",
	"foreground": "#ffffff",
    "component": "cmes-dashboard-count-chart",
    "link": "cmes-custom-page/W2Demo",
	"input": {
		"refresh": 60,
		"colors": ["#FFFFFF"],
		"inputOData":
		{
			"dataSource": "ProductionItemsValidations",
			"filter": "ValidationState eq 'ReproductionNecessary' and date(CreationDate) eq {Today}",
			"count": true
		}
    }
  },
  
  {
    "label": "Kundenaufträge",
    "cols": 2,
    "rows": 1,
    "background": "#009933",
    "component": "cmes-dashboard-count-chart",
    "link": "cmes-custom-page/W2Demo",
	"input": {
		"refresh": 120,
		"colors": ["#FFFFFF"],
		"inputOData":
		{
			"dataSource": "ProductionOrders",
			"groupField": "ProductionState",
			"valueFields": ["total"],
			"apply": "filter(date(DesiredEndDate) eq {Today} and ProductionState eq 'Finished')/groupby((ProductionState),aggregate(CustomerOrderCode with countdistinct as total))"
		}
	}
  },
  {
    "label": "Zuschnitt Fronten",
    "cols": 3,
    "rows": 3,
    "background": "#b3ccff",
    "component": "cmes-dashboard-pie-chart",
    "link": "cmes-custom-page/W2Demo",
    "input": {
		"names": ["30015 Saw"],
		"colors": ["#33b2df"],     
		"inputOData":
		{
			"dataSource": "ProductionSteps",
			"groupField": "ProductionState",
			"valueFields": ["total"],
			"apply": "filter(date(DesiredEndDateProcessing) eq {Today} and WorkCenterCode eq '30015 Saw')/groupby((ProductionState),aggregate(DesiredTargetQuantity with sum as total))"
		}
	}
  },
  {
    "label": "Fortschritt Zuschnitt",
    "cols": 4,
    "rows": 3,
    "background": "#ffffff",
    "component": "cmes-dashboard-bar-chart",
    "link": "cmes-custom-page/W2Demo",	
	"input": {
		"chartName":"30015 Saw",
		"refresh": 25,
		"names": ["30015 Saw"],
		"colors": ["#33b2df"],
		"inputOData":
			{
				"dataSource": "ViewFinishedPerHours",
				"groupField": "Hour",
				"valueFields": ["FinishedGood"],
				"filter": "WorkCenterCode eq '30015 Saw' and date(Date) eq {Today}"
			}
	}
  },
 {
    "label": "Fortschritt Kante",
    "cols": 4,
    "rows": 3,
    "background": "#ffdf80",
    "component": "cmes-dashboard-bar-chart",
    "link": "cmes-custom-page/W2Demo",
	"input": {
		"chartName":"30030 Edge",
		"names": ["30030 Edge"],
		"colors": ["#664d00"],
		"inputOData":
				{
					"dataSource": "ViewFinishedPerHours",
					"groupField": "Hour",
					"valueFields": ["FinishedGood"],
					"filter": "WorkCenterCode eq '30030 Edge' and date(Date) eq {Today}"
				}
	}
  },
  {
    "label": "Fortschritt Kante+Zuschnitt",
    "cols": 4,
    "rows": 3,
    "background": "#ffdf80",
    "component": "cmes-dashboard-bar-chart",
    "link": "cmes-custom-page/W2Demo",
	"input": {
		"chartName":"edge and saw",
		"names": ["30015 Saw Good","30030 Edge Good"],
		"colors": ["#33b2df","#664d00"],
		"inputOData":
		{
					"dataSource": "ViewFinishedPerHours",
					"groupField": "Hour",
					"valueGroupField":"WorkCenterCode",
					"valueGroupFieldValues":["30015 Saw","30030 Edge"],
					"valueFields": ["FinishedGood"],
					"filter": "(WorkCenterCode eq '30030 Edge' or WorkCenterCode eq '30015 Saw' ) and date(Date) eq {Today}"
		}
	}
  },
  {
    "label": "Fortschritt Kante Gut + Schlecht" ,
    "cols": 4,
    "rows": 3,
    "background": "#ffdf80",
    "component": "cmes-dashboard-bar-chart",
    "link": "cmes-custom-page/W2Demo",
	"input": {
		"chartName":"30030 Edge",
		"names": ["Good","Bad"],
		"colors": ["#664d00","#008FFB"],
		"inputOData":
				{
					"dataSource": "ViewFinishedPerHours",
					"groupField": "Hour",
					"valueFields": ["FinishedGood","FinishedBad"],
					"filter": "WorkCenterCode eq '30030 Edge' and date(Date) eq {Today}"
				}
	}
  },
  {
    "label": "letzte Fehler",
    "cols": 6,
    "rows": 2,
    "background": "#ff0000",
    "foreground": "#fff",
    "component": "cmes-dashboard-table-chart",
    "link": "cmes-custom-page/W2Demo",
    "input": {
      "names": ["Server Error"],
      "colors": ["#FF0000"],
      "inputOData":
	  {
		"dataSource": "CombinedLogItems",
		"select": "Date, Area, Message",
		"filter": "ApplicationType eq 'Web' and Level eq 'ERROR'",
		"orderBy": "Sequence desc",
		"top": 15
	  }
    }
  }
 ]
