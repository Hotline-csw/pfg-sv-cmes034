    "link": "cmes-jobs-health",
    "input": {
      "chartName": "cMES JobHistory",
      "refresh": 5,
      "inputMongo": {
        "dataSource": "JobHistory",
        "instance": "CMES_Health"
      }
    }
  },
{
    "label": "Cmes Server DemoVM",
    "cols": 6,
    "rows": 3,
    "background": "#ffffff",
    "foreground": "#000000",
    "component": "cmes-dashboard-cmes-perf-chart",
    "link": "cmes-health",
	"input": {
		"chartName":"cMES_Server_Host",
		"refresh": 2,
		"inputMongo":
		{
			"dataSource": "PerfmonOneSecond",
			"instance": "CMES_Health"
		}
	}
 },
{
    "label": "SQL Server DEV",
    "cols": 6,
    "rows": 3,
    "background": "#ffffff",
    "foreground": "#000000",
    "component": "cmes-dashboard-sql-server-perf-chart",
    "link": "sql-server-health",
	"input": {
		"chartName":"SqlServer DEV",
		"refresh": 2,
		"inputMongo":
		{
			"dataSource": "DatabasePerformance",
			"instance": "CMES_Health"
		}
	}
 },
  {
    "label": "Letzte cMES Server Exceptions",
    "cols": 6,
    "rows": 2,
    "background": "#ff0000",
    "foreground": "#fff",
    "component": "cmes-dashboard-table-chart",
    "input": {
      "names": ["Server Error"],
      "colors": ["#ff0000"],
      "inputOData":
	  {
		"dataSource": "CombinedLogItems",
		"select": "Date, Area, Message, Exception",
		"filter": "ApplicationType eq 'Web' and Exception ne null",
		"orderBy": "Sequence desc",
		"top": 15
	  },
	  "inputMongo":{}
    }
  },
  {
    "label": "Letzte cMES Server Fehler",
    "cols": 6,
    "rows": 2,
    "background": "#E3A300",
    "foreground": "#fff",
    "component": "cmes-dashboard-table-chart",
    "input": {
      "names": ["Server Error"],
      "colors": ["#E3A300"],
      "inputOData":
	  {
		"dataSource": "CombinedLogItems",
		"select": "Date, Area, Message",
		"filter": "ApplicationType eq 'Web' and Level eq 'ERROR' and Exception eq null",
		"orderBy": "Sequence desc",
		"top": 15
	  },
	  "inputMongo":{}
    }
  },
  {
    "label": "Benutzer",
    "cols": 2,
    "rows": 1,
    "background": "#FAF0E6",
    "component": "cmes-dashboard-user",
    "link": "cmes-custom-page/CmesHealthW3wp"
  }
 ]
