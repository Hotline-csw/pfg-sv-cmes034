<hgc:Dialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:hgc = "http://schemas.homag-group.com/ControlLibrary/1.0/xaml"
            xmlns:properties = "clr-namespace:HomagGroup.FLS.Infrastructure.Resource.Properties;assembly=HomagGroup.FLS.Infrastructure.Resource"
			Width="600" 
            Title="Auftragsbezogene Rückmeldung"
            SizeToContent="WidthAndHeight"
            FocusManager.FocusedElement="{Binding ElementName=DropDownWorkCenters}">
    <!-- Template für einen Custom Dialog -->
	<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width = "Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height = "Auto"/>
            <RowDefinition Height = "*"/>
        </Grid.RowDefinitions>
    	      
	        <TextBlock 	Grid.Row="0" 
        		Grid.Column="1" 
        		Text="{Binding CustomerOrder, Mode=TwoWay}"
        		FontSize="14"
        		FontWeight="Normal"
        		FontFamily="Tahoma"
        		Width = "500"
        		TextWrapping="Wrap"
        		Margin="10,10,10,10"/>

		    <hgc:DropDownList 
		        x:Name="DropDownWorkCenters"
		        Label="Arbeitsplatz auswählen"
		        Grid.Row = "1"
	        	Grid.Column = "1"
		        Width="350"
		        HorizontalAlignment="Center"
		        ItemsSource="{Binding DropDownWorkCenters, Mode=TwoWay}"
		        SelectedItem="{Binding DropDownWorkCenter, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/> 
    </Grid>
    <hgc:Dialog.Footer>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <hgc:ActionButton Label="{hgc:Translation Key=Ok,Resource={x:Static properties:Resources.ResourceManager}}"
                              IsImageVisible="False" MinWidth="150"
                              Command="{Binding ApplyCommand}"/>
            <hgc:ActionButton Label="{hgc:Translation Key=Cancel,Resource={x:Static properties:Resources.ResourceManager}}"
                              IsImageVisible="False" MinWidth="150"
                              Command="{Binding CloseCommand}"/>
        </StackPanel>
    </hgc:Dialog.Footer>
</hgc:Dialog>
