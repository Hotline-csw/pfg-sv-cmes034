<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hgc = "http://schemas.homag-group.com/ControlLibrary/1.0/xaml"
             xmlns:properties = "clr-namespace:HomagGroup.FLS.Infrastructure.Resource.Properties;assembly=HomagGroup.FLS.Infrastructure.Resource"
             hgc:UIAdjustments.DisplayMode="NonTouch">
    <!-- Template für einen Detaildialog im GenericManagement -->
    <Grid>
        <hgc:Label Extent="Header" Content="{Binding Name}" 
                   Visibility="{Binding MultipleParentsSelected, Converter={hgc:True2CollapsedConverter}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <hgc:Label Visibility="{Binding MultipleParentsSelected, Converter={hgc:False2CollapsedConverter}}" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Content="{hgc:Translation MultipleParentsSelected, Resource={x:Static properties:Resources.ResourceManager}}" />
    </Grid>

</UserControl>